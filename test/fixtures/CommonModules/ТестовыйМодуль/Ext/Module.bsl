// Тестовый общий модуль для проверки парсера

Перем МояПеременная;

Процедура ПубличнаяПроцедура(Параметр1, Параметр2 = 0) Экспорт

	ВспомогательнаяПроцедура(Параметр1);
	ДругойМодуль.ЭкспортныйМетод(Параметр2);

	Если Параметр1 > 0 Тогда
		РезультатФункции = ВычислитьЧтоТо(Параметр1, Параметр2);
	КонецЕсли;

КонецПроцедуры

Функция ВычислитьЧтоТо(Знач Значение1, Знач Значение2) Экспорт

	Результат = ОбщийМодульБСП.ОбщаяФункция(Значение1);
	Результат = Результат + ПомощникВычисления(Значение2);

	Возврат Результат;

КонецФункции

Процедура ВспомогательнаяПроцедура(Параметр)

	// Внутренний метод — не экспортный
	МойОбъект = Новый СписокЗначений;
	МойОбъект.Добавить(Параметр);

	ОбщийМодульБСП.ЗаписатьЛог("Вызов ВспомогательнаяПроцедура");

КонецПроцедуры

Функция ПомощникВычисления(Знач Значение)

	Возврат Значение * 2;

КонецФункции
